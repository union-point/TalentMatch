DATABASE_URL=postgresql+asyncpg://talentmatch_user:talentmatch_pass@localhost:5432/talentmatch_db
GEMINI_API_KEY=your-gemini-api-key-here
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# Authentication. Use a single public origin for the UI and /api proxy.
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:5173
AUTH_ALLOW_INSECURE_COOKIES=true
# Generate before startup:
# uv run python -c 'import json; from cryptography.fernet import Fernet; print(json.dumps([Fernet.generate_key().decode()]))'
AUTH_ENCRYPTION_KEYS=[]
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=43200
AUTH_CHALLENGE_SECONDS=600
AUTH_VERIFICATION_SECONDS=86400
AUTH_RESET_SECONDS=1800
AUTH_INVITATION_SECONDS=259200
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_EMAIL_ACCOUNT_LIMIT=3
AUTH_EMAIL_IP_LIMIT=20
# Local API: Mailpit SMTP is exposed on 1026; inbox UI: http://localhost:8026.
# Docker app/worker override the SMTP host/port to mailpit:1025.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TalentMatch <no-reply@localhost>
SMTP_TIMEOUT_SECONDS=15
